# Discord 개발자 포털(https://discord.com/developers/applications)에서 발급받은 봇 토큰
DISCORD_TOKEN=your_bot_token_here

# 봇이 응답할 서버(길드) ID. 이 목록에 없는 서버에서는 동작하지 않는다.
# Discord에서 개발자 모드를 켠 뒤 서버 아이콘을 우클릭 > ID 복사 로 확인
# 여러 서버를 등록하려면 쉼표로 구분: ALLOWED_GUILD_IDS=111111111111111111,222222222222222222
ALLOWED_GUILD_IDS=1541345080680644651

# 메시지 맨 앞이 이 단어들 중 하나와 정확히 일치해야 응답한다 (쉼표로 구분).
# 예: "해미야 안녕" -> "해미야"를 정확히 떼어내고 "안녕"만 봇에게 전달
CALL_PREFIXES=해미야,햄이야,햄스터야,해미보이야,햄아

# https://platform.openai.com/api-keys 에서 발급받은 API 키
# 절대 커밋하지 마세요. 이 값은 .env 파일에만 두고 .env는 git에 올리지 않습니다.
OPENAI_API_KEY=your_openai_api_key_here

# 규칙에 매칭되지 않은 메시지에 사용할 모델 (기본값: gpt-5-nano, 가장 저렴한 모델)
OPENAI_MODEL=gpt-5-nano

# 자연어 답변을 검수(judge)할 때 쓰는 모델. nano보다 판정 정확도가 필요해서 분리함.
# gpt-5.6-luna는 reasoning.effort="none"을 지원해서 nano처럼 추론 토큰에
# 예산을 뺏기지 않는다 (nano는 최저가 "minimal"까지만 가능).
OPENAI_JUDGE_MODEL=gpt-5.6-luna

# 응답 최대 토큰 수. gpt-5-nano는 reasoning 토큰도 이 예산을 나눠 쓰므로
# (engine.py에서 reasoning.effort=minimal로 최소화해둠) 100자 내외 답변에는
# 120 정도를 권장한다. 너무 낮추면 답변이 문장 중간에 잘릴 수 있다.
OPENAI_MAX_OUTPUT_TOKENS=120

# 프롬프트 캐시 라우팅 키. instructions 내용을 바꿀 때만 값도 같이 바꾸면 된다.
OPENAI_PROMPT_CACHE_KEY=hammieboye-chat-v3

# Supabase 프로젝트 URL (대시보드 > Project Settings > Data API 에서 확인).
# REST API 엔드포인트이므로 반드시 /rest/v1/ 를 붙여야 한다 (db/client.py가 이 값 뒤에
# 바로 테이블/rpc 경로를 붙여서 요청한다).
SUPABASE_URL=https://your-project-ref.supabase.co/rest/v1/

# Supabase service_role 키 (같은 화면에서 확인). RLS를 우회하는 강력한 키이므로
# 절대 커밋하지 말고, 클라이언트/프론트엔드 코드에는 절대 넣지 마세요.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
